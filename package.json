{
  "name": "mon-site-pro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "setup": "./scripts/setup.sh",
    "verify": "node scripts/verify-setup.js",
    "generate-secrets": "node scripts/generate-secrets.js",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml up --build -d",
    "db:backup": "docker exec mon-site-pro_postgres_1 pg_dump -U strapi strapi > ./backups/db_$(date +%Y%m%d).sql",
    "db:restore": "cat ./backups/db_file.sql | docker exec -i mon-site-pro_postgres_1 psql -U strapi strapi"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
